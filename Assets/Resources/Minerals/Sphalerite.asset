  m_Script: {fileID: 11500000, guid: 7f2581b0ddc9f008294c9d813ebdebb1, type: 3}
  m_Name: Sphalerite
  m_EditorClassIdentifier: Assembly-CSharp::Mineral
  id: 1
  mineralName: Sphalerite
  description: "Sphalerite is a zinc sulfide mineral found in metamorphic, igneous,
    and sedimentary rocks in many parts of the world. Sphalerite is the most commonly
    encountered zinc mineral and the world\u2019s most important ore of zinc.\nDozens
    of countries have mines that produce sphalerite. Recent top producers include
    Australia, Bolivia, Canada, China, India, Ireland, Kazakhstan, Mexico, Peru,
    and the United States.\n\nThe name sphalerite is from the Greek word \u201Csphaleros\u201D
    which means deceiving or treacherous. This name is in response to the many different
    appearances of sphalerite and because it can be challenging to identify in hand
    specimens. Names for sphalerite used in the past or by miners include \u201Czinc
    blende,\u201D \u201Cblackjack,\u201D \u201Csteel jack,\u201D and \u201Crosin
    jack.\u201D"
  rarity: 2
  maxVeinAmount: 1
  minVeinAmount: 15
  scaleRange: {x: 0.8, y: 1.3}
  mesh: {fileID: -2432090755550338912, guid: 99e829dc7a9b4009bb399e5251410f92, type: 3}
